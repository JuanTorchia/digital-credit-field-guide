{
  "name": "digital-credit-field-guide",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "dev": "next dev",
    "build": "pnpm artifacts:render && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "social:render": "tsx scripts/render-social.ts",
    "social:check": "pnpm social:render && git diff --exit-code -- public/social",
    "artifacts:render": "pnpm social:render && tsx scripts/sync-downloads.ts",
    "artifacts:check": "pnpm artifacts:render && git diff --exit-code -- public/social app/opengraph-image.png public/downloads",
    "test:e2e": "playwright test",
    "links:check": "tsx scripts/check-links.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm content:validate && pnpm artifacts:check && pnpm build && pnpm test:e2e && pnpm links:check"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/twitter-text": "^3.1.10",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "twitter-text": "^3.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
